/*
 * Overlay for nrf52840dongle_nrf52840 (PCA10059).
 *
 * IMPORTANT: the dongle only has ONE button wired at the factory (SW1,
 * used to enter DFU mode at boot) and an RGB LED - no extra user
 * buttons. For your 2 (then 5) buttons, you need to wire them yourself
 * on the castellated pads exposed on the edge of the board.
 *
 * The pins below (P0.13 and P0.15) are given as a common example used
 * in the nRF52840 Dongle community - CHECK THEM against the "Pin
 * assignment" section of the Nordic User Guide (nRF52840 Dongle,
 * PCA10059) before soldering anything, some pads are shared with the
 * USB D+/D- lines and MUST NOT be used as GPIO.
 */

/ {
	buttons {
		compatible = "gpio-keys";

		button_cam_on: button_cam_on {
			gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Camera ON";
		};

		button_cam_off: button_cam_off {
			gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Camera OFF";
		};
		/* BUTTON1 = SW1 = P1.06 (matches Zephyr's built-in sw0/button0 for this board) */
		button_sw1: button_sw1 {
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW1";
		};

		/* To add later, once the 3 Garmin buttons are wired:
		 * button_page_r, button_page_l, button_lap
		 */
	};

	aliases {
		sw-cam-on = &button_cam_on;
		sw-cam-off = &button_cam_off;
		sw1 = &button_sw1;
	};
};
